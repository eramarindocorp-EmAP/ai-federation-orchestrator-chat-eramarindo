# Placeholder names only. Never put real values in this file.
# Populate local values in .env.local and production values in a managed secret store.

# Application
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Supabase (server-side values configured after project provisioning)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider credentials (server-side only)
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Provider model identifiers must be verified and configured per environment.
OPENAI_MODEL=
GOOGLE_AI_MODEL=
DEEPSEEK_MODEL=
ANTHROPIC_MODEL=

# Operational safety limits
FEDERATION_MAX_AGENTS_PER_RUN=3
FEDERATION_MAX_TURNS=4
FEDERATION_MAX_PARALLEL_REQUESTS=3
FEDERATION_REQUEST_TIMEOUT_MS=60000
FEDERATION_DAILY_BUDGET_USD=10
